{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report Studio design",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": "string",
      "description": "Id of the parent design"
    },
    "finding_prefix": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "stylesheets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme": {
      "type": "object"
    },
    "severities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "min": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "report_fields": {
      "$ref": "#/definitions/fields"
    },
    "finding_fields": {
      "$ref": "#/definitions/fields"
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "item_label": {
                "type": "string"
              },
              "item_var": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "sort": {
                "type": "string",
                "description": "severity, manual, <field> or -<field>"
              },
              "title_field": {
                "type": "string"
              },
              "layout": {
                "enum": [
                  "sections",
                  "table",
                  "timeline"
                ]
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "page_break": {
                "type": "boolean"
              },
              "icon": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "$ref": "#/definitions/fields"
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "fields": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "enum": [
              "string",
              "text",
              "markdown",
              "code",
              "number",
              "boolean",
              "enum",
              "date",
              "datetime",
              "list",
              "table",
              "cvss",
              "image",
              "screenshots",
              "user",
              "color",
              "font",
              "range"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "text",
                  "markdown",
                  "code",
                  "number",
                  "boolean",
                  "enum",
                  "date",
                  "datetime",
                  "list",
                  "table",
                  "cvss",
                  "image",
                  "screenshots",
                  "user",
                  "color",
                  "font",
                  "range"
                ]
              },
              "label": {
                "type": "string"
              },
              "help": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              },
              "copy": {
                "type": "boolean",
                "description": "false: not copied when a new report is created from this one with \"Change Report Type\" (e.g. retest results)"
              },
              "required": {
                "type": "boolean"
              },
              "default": {},
              "group": {
                "type": "string"
              },
              "rows": {
                "type": "number",
                "description": "Editor height in lines (markdown, text, code)"
              },
              "options": {
                "type": "array",
                "description": "enum: values or { value, label, color }"
              },
              "items": {
                "enum": [
                  "string",
                  "markdown"
                ],
                "description": "list: type of each entry"
              },
              "columns": {
                "description": "table: columns of each row (same syntax as fields)"
              },
              "language": {
                "type": "string",
                "description": "code: default highlight.js language"
              },
              "lines": {
                "type": "boolean",
                "description": "code: print line numbers by default"
              },
              "section": {
                "enum": [
                  "before",
                  "after",
                  "details",
                  "none"
                ],
                "description": "report fields: where generic templates print it"
              },
              "display": {
                "enum": [
                  "cards",
                  "segmented",
                  "select"
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              }
            }
          }
        ]
      }
    }
  }
}